{
  "name": "sitar-table-tennis",
  "version": "0.6.1",
  "private": true,
  "type": "module",
  "description": "ブラウザで遊べる卓球ゲームの開発・検証環境",
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "npm@11.11.0",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check:app": "node scripts/check-app.mjs",
    "check:dist": "node scripts/check-dist.mjs",
    "test:unit": "node --test tests/app-contract.test.mjs tests/game-core.test.ts tests/opponent-ai.test.ts tests/stats.test.ts",
    "test:e2e": "playwright test",
    "test": "npm run test:unit && npm run test:e2e",
    "check": "npm run lint && npm run typecheck && npm run check:app && npm run build && npm run check:dist && npm run test"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.0",
    "@types/node": "24.13.3",
    "eslint": "10.8.0",
    "globals": "17.8.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vite": "8.1.5"
  }
}
